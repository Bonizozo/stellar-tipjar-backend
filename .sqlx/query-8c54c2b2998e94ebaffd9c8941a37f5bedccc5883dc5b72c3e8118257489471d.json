  "db_name": "PostgreSQL",
  "query": "\n            SELECT \n                id, creator_id, email_type, recipient, subject,\n                status as \"status: EmailStatus\",\n                error_message, sent_at, delivered_at, bounced_at, created_at\n            FROM email_deliveries\n            WHERE creator_id = $1\n            ORDER BY created_at DESC\n            LIMIT $2\n            ",
