  "query": "\n            SELECT id, job_type, payload, status, retry_count, max_retries,\n                   created_at, scheduled_at, started_at, completed_at,\n                   error_message, worker_id, priority\n            FROM jobs\n            WHERE status = 'failed'\n            ORDER BY completed_at DESC\n            LIMIT $1\n            ",
